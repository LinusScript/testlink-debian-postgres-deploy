# Kopieren nach .env und Werte anpassen:
#   cp .env.example .env
#
# WICHTIG: .env enthaelt Passwoerter und wird NICHT ins Git-Repo committet (siehe .gitignore).

# --- TestLink ---
# Tag aus https://github.com/TestLinkOpenSourceTRMS/testlink-code/tags
# Ziel-Version. Produktion laeuft aktuell auf 1.9.16 (MySQL/MariaDB) - der Weg
# von dort zu dieser Version + PostgreSQL ist in docs/tutorial/10-12 dokumentiert.
TL_VERSION=1.9.20-20251208
# Zielverzeichnis auf dem Server, in das TestLink entpackt wird
TL_INSTALL_DIR=/var/www/testlink
# Domain oder IP, unter der TestLink erreichbar sein soll (fuer den Apache VirtualHost)
TL_DOMAIN=testlink.demo.local
# Port, auf dem Apache den VirtualHost bereitstellt
TL_HTTP_PORT=80

# --- PostgreSQL ---
# Passwort, das dem PostgreSQL-Superuser "postgres" gesetzt wird.
# Der TestLink-Webinstaller verbindet sich damit als "Datenbank-Administrator"
# und legt Datenbank + eigenen TestLink-DB-User SELBST an (siehe docs/03-postgresql-setup.md).
PG_SUPERUSER_PASSWORD=change-me-strong-password
PG_HOST=127.0.0.1
PG_PORT=5432

# Name/Login, den TestLink fuer seine eigene Datenbank+User anlegen soll.
# Diese Werte gibst du im Web-Installer ein (siehe docs/05-web-installer-walkthrough.md) -
# hier nur als Referenz/Notiz fuer dich, damit du sie beim Ausfuellen griffbereit hast.
TL_DB_NAME=testlink
TL_DB_USER=tl_login
TL_DB_PASSWORD=change-me-another-strong-password
